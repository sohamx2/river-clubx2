# Required for Vercel. Copy your Neon PostgreSQL connection string here.
# Never prefix this with NEXT_PUBLIC_. It belongs on the server only.
DATABASE_URL=
# Local development automatically uses .local-data when DATABASE_URL is empty.
# Local production smoke tests only; deliberately ignored on Vercel.
# ALLOW_LOCAL_STORE=true

# Optional: browser-visible WebRTC ICE server JSON, including a TURN relay if needed.
# Use client relay credentials, never a provider management API key.
# NEXT_PUBLIC_RTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
